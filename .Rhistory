knitr::opts_chunk$set(echo = TRUE)
library(dplyr)
library(tidyverse)
library(rstan)
library(rstanarm)
library(shinystan)
library(bayesplot)
library(pkgbuild)
library(boot)
library(loo)
library(MASS)
#install.packages("remotes")    #run this line and the next once to get access to the sgen solver that DFO has developed
#remotes::install_github("Pacific-salmon-assess/samSim", ref="sbccnk", force=TRUE)
library(samSim) #package that DFO created with the sgen solver to estimate sgen given stock recruit parameters
pkgbuild::has_build_tools(debug = TRUE)
rstan_options(auto_write=T)
options(mc.cores = parallel::detectCores())
#escapement data
esc_dat <- read.csv("SP_1.2\\Data_in\\sp1.2_smu_no_escape.csv")
head(esc_dat)
#posterior data
pos_dat <- readRDS("data\\post.rds")
head(pos_dat)
#age data
age_dat <- read.csv("SP_1.2\\Data_in\\rec_age_comp.csv")
head(age_dat)
#Escapement correlation - filter out pops with high hatchery influence & no NO estimates, and filter out years with NAs
`%!in%` <- Negate(`%in%`)
dat <- esc_dat %>% filter(Pop_Name %!in% c("NICOLA RIVER-UPPER", "SPIUS CREEK", "COLDWATER RIVER"))
bess <- dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(TotalInfilled = sum(TotalInfilled, na.rm = F))
dat_simp <- dat %>% filter(Pop_Name %!in% c("BESSETTE CREEK", "HARRIS CREEK", "CREIGHTON CREEK", "DUTEAU CREEK"))
dat_bess <- dat %>% filter(Pop_Name == "BESSETTE CREEK") %>% dplyr::select(-TotalInfilled) %>%
bind_cols(., TotalInfilled = bess$TotalInfilled)
dat <- bind_rows(dat_simp, dat_bess)
source("R\\pop_cor.R")
corr <- pop_cor(dat)
corr
#Ricker Parameter Posteriors - fill in the beta column based on the alpha and sigma posterior from the Nicola S-R
post <- readRDS("data\\post.rds")
rws <- sample(x = 1:30000, size = 1000, replace = F)
post_nic <- post[rws,] %>% arrange(beta)
post_nic
read.csv("//data//srep_habitat_model_data_stream-type_May 2025.csv")
read.csv("/data/srep_habitat_model_data_stream-type_May 2025.csv")
read.csv("data/srep_habitat_model_data_stream-type_May 2025.csv")
read.csv("data\\srep_habitat_model_data_stream-type_May 2025.csv")
read.csv("data\srep_habitat_model_data_stream-type_May 2025.csv")
read.csv("data\\srep_habitat_model_data_stream-type_May 2025.csv")
read.csv("data\\srep_habitat_model_data_stream-type_ May 2025.csv")
dat <- read.csv("data\\srep_habitat_model_data_stream-type_ May 2025.csv")
wa_dat <- read.csv("data\\srep_habitat_model_data_stream-type_ May 2025.csv")
#creating the list of data to feed to Stan
dat <- list("N" = nrow(wa_dat),                  #number of years of data
"srep" = wa_dat$srep, #logit-transformed smolt to age 3 adult survival
"wa" = wa_dat$watershed_area) #mean logit-transformed survival
dat
