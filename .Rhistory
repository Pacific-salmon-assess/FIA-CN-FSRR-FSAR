group_by(Year) %>%
summarize(total_no_spawners = sum(no_spawners, na.rm = TRUE))
spawn <- smu_total %>% ggplot(aes(x = Year, y = total_no_spawners/1000))+
geom_line(color= "black", linewidth = 1.2)+
labs(x = "Return year", y = "Spawner abundance (1000s)")+
scale_y_continuous(breaks = seq(0, max(smu_dat$no_spawners / 1000) + 20, by = 5))+
scale_x_continuous(limits = c(2008, 2024),
breaks = seq(2008,2024, by =5))+
theme_classic()
print(spawn)
write.csv(smu_total, "smu_esc_sp_1.3.csv")
spring13_stocks <- c("Lower Fraser River_SP_1.3",
"Middle Fraser-Fraser Canyon_SP_1.3",
"Middle Fraser River_SP_1.3",
"Upper Fraser River_SP_1.3",
"North Thompson_SP_1.3"
)
smu_dat <- esc_dat %>%
filter(Year > 2009,
Stock %in% spring13_stocks)%>%
group_by(Stock, Year) %>%
summarize(no_spawners = sum(SpnForTrend_Wild, na.rm = TRUE), .groups = "drop" )
smu_total <- smu_dat %>%
group_by(Year) %>%
summarize(total_no_spawners = sum(no_spawners, na.rm = TRUE))
spawn <- smu_total %>% ggplot(aes(x = Year, y = total_no_spawners/1000))+
geom_line(color= "black", linewidth = 1.2)+
labs(x = "Return year", y = "Spawner abundance (1000s)")+
scale_y_continuous(breaks = seq(0, max(smu_dat$no_spawners / 1000) + 20, by = 5))+
scale_x_continuous(limits = c(2008, 2024),
breaks = seq(2008,2024, by =4))+
theme_classic()
print(spawn)
write.csv(smu_total, "smu_esc_sp_1.3.csv")
ER <- ER_dat %>%
select(year, FMI, CYER) %>%
pivot_longer(
cols = c(FMI, CYER),
names_to = "source",
values_to = "ER"
) %>%
mutate(
source = recode(
source,
CYER = "CYER",
FMI  = "FMI"
))
ER <- ER %>%
ggplot(aes(x = year, y = ER, colour = source)) +
geom_line(linewidth = 1.2) +
labs(
x = "Return year",
y = "Exploitation Rate",
colour = NULL
) +
scale_colour_manual(
values = c("CYER" = "black", "FMI" = "grey70")
) +
scale_y_continuous(
breaks = seq(
0,
max(ER$ER, na.rm = TRUE) + 0.5,
by = 0.05
)
) +
scale_x_continuous(limits = c(2019, 2024)) +
geom_hline(yintercept = 0.40, colour = "red",  linewidth = 0.8) +
geom_text(
data = data.frame(x = 2024, y = 0.40),
aes(x = x, y = y, label = "U[MSY]"),
colour = "red",
hjust = 1.1,
vjust = 1.0,
size = 3.5,
parse = TRUE
) +
geom_hline(yintercept = 0.10, colour = "red", linewidth = 0.8) +
geom_text(
data = data.frame(x = 2024, y = 0.10), # Insert finalized lower fishery reference point
aes(x = x, y = y, label = "FRP-L"),
colour = "red",
hjust = 1.1,
vjust = -0.3,
size = 3.5,
parse = TRUE
) +
theme_classic()
print(ER)
four_plot <- plot_grid(catch, spawn, ER, recruit,
labels = c("(A)", "(B)", "(C)", "(D)"),
label_size = 12,
align = "v",
label_x = 0.87)
cat <- ER_dat %>%
select(year, catch_CYER, catch_FMI) %>%
pivot_longer(
cols = c(catch_CYER, catch_FMI),
names_to = "source",
values_to = "catch"
) %>%
mutate(
source = recode(
source,
catch_CYER = "CYER",
catch_FMI  = "FMI"
))
# recs <- escape %>% mutate(p_spawn = 1-ER,
#                           recs = no_spawners / p_spawn) %>% group_by(ret_year) %>%
#   summarize(smu_recs = sum(recs))
catch <- cat %>%
ggplot(aes(x = year, y = catch / 1000, colour = source)) +
geom_line(linewidth = 1.2) +
labs(
x = "Return year",
y = "Catch (1000s)",
colour = NULL
) +
scale_colour_manual(
values = c("CYER" = "black", "FMI" = "grey70")
) +
scale_y_continuous(
breaks = seq(
0,
max(recs$recruits, na.rm = TRUE) / 1000,
by = 1
)
) +
scale_x_continuous(limits = c(2019, 2024)) +
theme_classic()
