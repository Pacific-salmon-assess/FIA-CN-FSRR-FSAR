set.seed(123)
set.seed(123)
# ---- 1) Simulation settings ----
nA <- 250
nB <- 250
# Size ranges (A narrower, B wider with overlap)
sizeA <- runif(nA, 60, 90)
sizeB <- runif(nB, 45, 90)
# Center/scale size for numerical stability (recommended)
size_all <- c(sizeA, sizeB)
size_c   <- scale(size_all, center = TRUE, scale = TRUE)[,1]
sizeA_c  <- size_c[1:nA]
sizeB_c  <- size_c[(nA+1):(nA+nB)]
# True effects on logit scale:
# A: baseline survival higher, positive size effect
# B: lower baseline survival, moderately different size effect
alpha_A <-  0.5      # intercept for A
beta_A  <-  0.9      # slope for A (per 1 SD size)
alpha_B <- -0.2      # lower survival in B (lower intercept)
beta_B  <-  0.5      # moderately different size effect (shallower slope)
# Generate survival probabilities and outcomes
logitA <- alpha_A + beta_A * sizeA_c
logitB <- alpha_B + beta_B * sizeB_c
pA <- plogis(logitA)
pB <- plogis(logitB)
yA <- rbinom(nA, 1, pA)
yB <- rbinom(nB, 1, pB)
dat <- data.frame(
exp  = factor(c(rep("A", nA), rep("B", nB))),
size = c(sizeA, sizeB),
size_c = c(sizeA_c, sizeB_c),
y    = c(yA, yB)
)
# ---- 2) Fit logistic regressions (GLMs) ----
# (You wrote "lm", but for logit you want glm(..., family=binomial))
m_no_int <- glm(y ~ size_c + exp, data = dat, family = binomial)
m_int    <- glm(y ~ size_c * exp, data = dat, family = binomial)
print(summary(m_no_int))
print(summary(m_int))
length(sizeA_c)
length(sizeB_c)
# ---- 3) Prediction grid for Experiment A across FULL size range ----
# Create a size grid spanning the full observed range (45–90)
size_grid <- seq(45, 90, by = 0.25)
# IMPORTANT: use same centering/scaling as in the model fit
# IMPORTANT: use same centering/scaling as in the model fit
size_grid_c <- (size_grid - attr(scale(size_all), "scaled:center")) /
attr(scale(size_all), "scaled:scale")
newA <- data.frame(
exp = factor("A", levels = levels(dat$exp)),
size = size_grid,
size_c = size_grid_c
)
# ---- 4) Get predictions + standard errors on link scale, convert to prob ----
pred_fun <- function(fit, newdata, label){
pr <- predict(fit, newdata = newdata, type = "link", se.fit = TRUE)
data.frame(
model = label,
size  = newdata$size,
exp   = newdata$exp,
fit_link = pr$fit,
se_link  = pr$se.fit,
fit = plogis(pr$fit),
lwr = plogis(pr$fit - 1.96 * pr$se.fit),
upr = plogis(pr$fit + 1.96 * pr$se.fit)
)
}
predA_no_int <- pred_fun(m_no_int, newA, "No interaction")
predA_int    <- pred_fun(m_int,    newA, "With interaction")
predA <- rbind(predA_no_int, predA_int)
# ---- 5) Plot: predictions for Experiment A across 45–90 ----
# Add points showing observed A data (note: only 60–90 exists)
suppressPackageStartupMessages({
library(ggplot2)
})
ggplot(predA, aes(x = size, y = fit, color = model, fill = model)) +
geom_ribbon(aes(ymin = lwr, ymax = upr), alpha = 0.18, color = NA) +
geom_line(linewidth = 1.1) +
geom_point(data = subset(dat, exp == "A"),
aes(x = size, y = y),
inherit.aes = FALSE,
alpha = 0.25, size = 1.4) +
geom_vline(xintercept = c(60, 90), linetype = 3, alpha = 0.6) +
annotate("text", x = 52, y = 0.98, label = "Extrapolation region for A (<60)",
hjust = 0, size = 3.4, alpha = 0.8) +
scale_y_continuous(limits = c(0, 1)) +
labs(
title = "Predicted survival for Experiment A across full size range",
subtitle = "Compare GLM with vs without size×experiment interaction (true effects differ by experiment)",
x = "Body size",
y = "Predicted survival probability",
color = "Model",
fill  = "Model"
) +
theme_minimal(base_size = 12)
# ---- 6) Optional: show the true underlying A & B curves (for sanity) ----
# (Not asked, but useful for checking simulation behaves as intended.)
true_grid_c <- (size_grid - attr(scale(size_all), "scaled:center")) /
attr(scale(size_all), "scaled:scale")
truth <- data.frame(
size = size_grid,
A = plogis(alpha_A + beta_A * true_grid_c),
B = plogis(alpha_B + beta_B * true_grid_c)
)
ggplot(truth, aes(x = size)) +
geom_line(aes(y = A), linewidth = 1.1) +
geom_line(aes(y = B), linewidth = 1.1, linetype = 2) +
scale_y_continuous(limits = c(0, 1)) +
labs(
title = "True survival curves used in simulation",
subtitle = "Solid = A, Dashed = B (B has lower intercept and different size effect)",
x = "Body size",
y = "True survival probability"
) +
theme_minimal(base_size = 12)
