names(nu_srep) <- c(unique(nu_wa$pop))
head(nu_srep)
?order_by
?arrange
nu_srep %>% arrange(`Bonaparte River`)
names(nu_wa)[1]
?pivot_longer
nu_srep <- srep_est(nu_wa)
nu_srep
names(nu_srep) <- c(unique(nu_wa$pop))
#Estimate beta posterior from nu_srep posterior
nu_beta <- nu_srep %>%
pivot_longer(names_to = "pop")
#Estimate beta posterior from nu_srep posterior
nu_beta <- nu_srep %>%
pivot_longer(names_to = "pop", cols = c(1:4))
nu_beta
#Estimate beta posterior from nu_srep posterior
nu_beta <- nu_srep %>%
pivot_longer(names_to = "pop", cols = c(1:4)) %>% arrange(pop)
nu_beta
sample(nu_srep, 1000)
