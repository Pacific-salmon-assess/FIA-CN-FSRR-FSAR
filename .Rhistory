#escapement data
esc_dat <- read.csv("SP_1.2\\Data_in\\sp1.2_smu_no_escape.csv")
head(esc_dat)
#posterior data
pos_dat <- readRDS("data\\post.rds")
head(pos_dat)
#age data
age_dat <- read.csv("SP_1.2\\Data_in\\rec_age_comp.csv")
head(age_dat)
#Escapement correlation - filter out pops with high hatchery influence & no NO estimates, and filter out years with NAs
`%!in%` <- Negate(`%in%`)
dat <- esc_dat %>% filter(Pop_Name %!in% c("NICOLA RIVER-UPPER", "SPIUS CREEK", "COLDWATER RIVER"))
dat
dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(Total_Infilled = sum())
dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(Total_Infilled = sum(Total_Infilled))
dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(return = sum(Total_Infilled))
dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(return = sum(TotalInfilled))
?sum
dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(return = sum(TotalInfilled, na.rm = T))
bess <- dat %>% filter(CU_ID == "CK-16") %>% group_by(Year) %>% summarize(return = sum(TotalInfilled, na.rm = T))
bess
tail(bess)
dat %>% filter(CU_ID == "CK-16")
