function(x) {
read_xlsx(
here::here(
"data", "ctc",
"2024 Fraser CWT Detailed Mortality Distribution Tables 16May2025_marked_only.xlsx"
),
sheet = x,
skip = 9#,
# col_names = FALSE
) %>%
janitor::clean_names() %>%
select(
stock, catch_year, can_marine_cyer = total_mortality
) %>%
filter(
!is.na(stock)
)
}
) %>%
bind_rows() %>%
mutate(
logit_cyer = boot::logit(can_marine_cyer)
)
ggplot(dat) +
geom_point(aes(x = catch_year, y = logit_cyer, color = stock))
dat_wide <- dat %>%
select(-can_marine_cyer)
dat_wide <- dat %>%
select(-can_marine_cyer) %>%
pivot_wider(
names_from = "stock", values_from = "logit_cyer"
)
dat_wide
cyer_mat <- dat_wide %>%
select(-catch_year) %>%
as.matrix() %>%
# center (do not scale to account for different variances)
apply(., 2, function (x) x - mean(x, na.rm = T)) %>%
t()
cyer_mat
yrs <- dat$catch_year %>% unique()
n_ts <- nrow(cyer_mat)
mean(cyer_mat[1,])
mean(cyer_mat[2,])
# unique obs var
model.list1 <- list(
Z = matrix("z", nrow = n_ts, ncol = 1),  # each time series loads on single latent trend
R = "diagonal and unequal",
A = "zero",
x0 = "zero",  # initial state is zero
U = "zero",   # no drift in latent trend
Q = "unconstrained"
)
fit1 <- MARSS(cyer_mat, model = model.list1)
## plot predictions
pred_dat <- predict(fit1, type = "ytT", interval = "confidence")$pred %>%
mutate(
year = t + 1984
) %>%
rename(
stock = .rownames
) %>%
group_by(
stock
) %>%
mutate(
obs_mean = mean(y, na.rm = T),
real_obs = y + obs_mean,
real_estimate = estimate + obs_mean
)
ggplot(pred_dat) +
geom_point(aes(x = year, y = real_obs)) +
geom_line(aes(x = year, y = real_estimate)) +
facet_wrap(
~ stock
)
## plot predictions
pred_dat <- predict(fit1, type = "ytT", interval = "confidence")$pred %>%
mutate(
year = t + 1984
) %>%
rename(
stock = .rownames
) %>%
group_by(
stock
) %>%
mutate(
obs_mean = mean(y, na.rm = T),
real_obs = boot::inv.logit(y + obs_mean),
real_estimate = boot::inv.logit(estimate + obs_mean)
)
ggplot(pred_dat) +
geom_point(aes(x = year, y = real_obs)) +
geom_line(aes(x = year, y = real_estimate)) +
facet_wrap(
~ stock
)
## plot predictions
pred_dat <- predict(fit1, type = "ytT", interval = "confidence")$pred %>%
mutate(
year = t + 1984
) %>%
rename(
stock = .rownames
) %>%
group_by(
stock
) %>%
mutate(
obs_mean = mean(y, na.rm = T),
real_obs = y + obs_mean,
real_estimate = estimate + obs_mean
# real_obs = boot::inv.logit(y + obs_mean),
# real_estimate = boot::inv.logit(estimate + obs_mean)
)
pred_dat %>% select(stock, obs_mean) %>% distinct()
glimpse(dat)
## plot predictions
mean_dat <- dat %>%
group_by(stock) %>%
summarize(
mean_logit_cyer = mean(logit_cyer, na.rm = T)
)
mean_dat
pred_dat <- predict(fit1, type = "ytT", interval = "confidence")$pred %>%
rename(
stock = .rownames
) %>%
left_join(., mean_dat, by = "stock") %>%
glimpse()
pred_dat <- predict(fit1, type = "ytT", interval = "confidence")$pred %>%
rename(
stock = .rownames
) %>%
left_join(., mean_dat, by = "stock") %>%
mutate(
year = t + 1984,
real_obs = boot::inv.logit(y + mean_logit_cyer),
real_estimate = boot::inv.logit(estimate + mean_logit_cyer)
)
ggplot(pred_dat) +
geom_point(aes(x = year, y = real_obs)) +
geom_line(aes(x = year, y = real_estimate)) +
facet_wrap(
~ stock
)
# DFA version
model.list_dfa2 <- list(
Z = matrix(list("z1", "z2"), nrow = n, ncol = 2),  # flexible loadings
R = "diagonal and unequal",   # observation error for each series
A = "zero",                   # intercepts; set to "zero" if demeaned
x0 = "zero",                  # initial state
U = "zero",                   # no drift
Q = "diagonal and unequal",   # each trend evolves independently
B = "identity"                # random walk structure
)
# DFA version
model.list_dfa2 <- list(
Z = matrix(list("z1", "z2"), nrow = n_ts, ncol = 2),  # flexible loadings
R = "diagonal and unequal",   # observation error for each series
A = "zero",                   # intercepts; set to "zero" if demeaned
x0 = "zero",                  # initial state
U = "zero",                   # no drift
Q = "diagonal and unequal",   # each trend evolves independently
B = "identity"                # random walk structure
)
fit_dfa2 <- MARSS(cyer_mat, model = model.list_dfa2, form = "dfa")
# DFA version
model.list_dfa2 <- list(
#Z = matrix(list("z1", "z2"), nrow = n_ts, ncol = 2),  # flexible loadings
m = 2,
R = "diagonal and unequal",   # observation error for each series
A = "zero",                   # intercepts; set to "zero" if demeaned
x0 = "zero",                  # initial state
U = "zero",                   # no drift
Q = "diagonal and unequal",   # each trend evolves independently
B = "identity"                # random walk structure
)
fit_dfa2 <- MARSS(cyer_mat, model = model.list_dfa2, form = "dfa")
# DFA version
model.list_dfa2 <- list(
#Z = matrix(list("z1", "z2"), nrow = n_ts, ncol = 2),  # flexible loadings
m = 2,
R = "diagonal and unequal",   # observation error for each series
A = "zero",                   # intercepts; set to "zero" if demeaned
x0 = "zero",                  # initial state
# U = "zero",                   # no drift
Q = "diagonal and unequal",   # each trend evolves independently
B = "identity"                # random walk structure
)
fit_dfa2 <- MARSS(cyer_mat, model = model.list_dfa2, form = "dfa")
fit1$AIC
# DFA version
model.list_dfa1 <- list(
m = 1,
R = "diagonal and unequal",   # observation error for each series
A = "zero",                   # intercepts; set to "zero" if demeaned
x0 = "zero",                  # initial state
# U = "zero",                   # no drift
Q = "diagonal and unequal",   # each trend evolves independently
B = "identity"                # random walk structure
)
fit_dfa1 <- MARSS(cyer_mat, model = model.list_dfa1, form = "dfa")
pred_dat <- predict(fit_dfa2, type = "ytT", interval = "confidence")$pred %>%
glimpse()
pred_dat <- predict(fit_dfa2, type = "ytT", interval = "confidence")$pred %>%
rename(
stock = .rownames
) %>%
left_join(., mean_dat, by = "stock") %>%
mutate(
year = t + 1984,
real_obs = boot::inv.logit(y + mean_logit_cyer),
real_estimate = boot::inv.logit(estimate + mean_logit_cyer)
)
ggplot(pred_dat) +
geom_point(aes(x = year, y = real_obs)) +
geom_line(aes(x = year, y = real_estimate)) +
facet_wrap(
~ stock
)
pred_dat <- predict(fit_dfa1, type = "ytT", interval = "confidence")$pred %>%
rename(
stock = .rownames
) %>%
left_join(., mean_dat, by = "stock") %>%
mutate(
year = t + 1984,
real_obs = boot::inv.logit(y + mean_logit_cyer),
real_estimate = boot::inv.logit(estimate + mean_logit_cyer)
)
ggplot(pred_dat) +
